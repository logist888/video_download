{
  "manifest_version": 3,
  "name": "video for me",
  "version": "1.2.0",
  "description": "Находит видео и аудио на странице (MP4, WebM, HLS) и скачивает их без ограничений.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "video for me",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scan.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}